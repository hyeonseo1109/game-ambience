<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GameAmbient</AssemblyName>
    <RootNamespace>GameAmbient.Windows</RootNamespace>
    <Product>Game Ambient</Product>
    <Description>Peripheral HUD feedback for Windows games</Description>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameAmbient.Core\GameAmbient.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <Compile Remove="Capture\WindowsGraphicsCaptureSource.CrossBuild.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Capture\WindowsGraphicsCaptureSource.cs" />
  </ItemGroup>
</Project>
