<Window x:Class="GameAmbient.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="game ambience" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#10151A" BorderBrush="#242B33" BorderThickness="0,0,1,0">
            <DockPanel Margin="24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="game ambience" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="HUD · peripheral signal" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,28" />
                    <Border Background="#1A222A" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="SETUP" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Screenshot calibration" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#151A20" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="DEVELOP" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Pipeline simulator" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="LOCAL ONLY" FontSize="10" Foreground="#64C18A"/>
                    <TextBlock Text="No injection · no uploads" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,40">
                <DockPanel Margin="0,0,0,22">
                    <StackPanel><TextBlock Text="Health signal setup" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Import a screenshot, then drag across the health bar." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                    <Border DockPanel.Dock="Right" Background="#18251F" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="StatePill" Text="UNKNOWN" Foreground="#72D69A" FontWeight="SemiBold"/></Border>
                </DockPanel>

                <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="LIVE MONITORING" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="CaptureStatusText" Text="Select an ROI, then choose a game window or monitor." Margin="0,5,0,0"/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Load profile" Click="LoadProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="Save profile" Click="SaveProfile_Click" Margin="0,0,8,0"/>
                            <Button x:Name="StopMonitoringButton" Content="Stop" Click="StopMonitoring_Click" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="StartMonitoringButton" Style="{StaticResource PrimaryButton}" Content="Choose target" Click="StartMonitoring_Click"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="360"/></Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,12"><TextBlock Text="REFERENCE SCREENSHOT" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Import PNG / JPEG" Click="ImportScreenshot_Click"/></DockPanel>
                            <Border Grid.Row="1" Background="#090B0E" CornerRadius="8" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid x:Name="ImageSurface" Background="#090B0E" MouseLeftButtonDown="ImageSurface_MouseLeftButtonDown" MouseMove="ImageSurface_MouseMove" MouseLeftButtonUp="ImageSurface_MouseLeftButtonUp">
                                        <Image x:Name="ScreenshotImage" Stretch="Fill"/>
                                        <Canvas IsHitTestVisible="False"><Rectangle x:Name="RoiRectangle" Stroke="#FF665F" StrokeThickness="3" Fill="#22FF665F" Visibility="Collapsed"/></Canvas>
                                        <TextBlock x:Name="EmptyScreenshotText" Text="Drop in a game screenshot to begin" Foreground="#697581" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DETECTOR OUTPUT" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Detected HP" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetectedValueText" Text="—" FontSize="34" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Confidence" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ConfidenceText" Text="—" FontSize="34" FontWeight="SemiBold"/></StackPanel></Grid>
                                <TextBlock Text="Matching mask" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,7"/>
                                <Border Height="76" Background="#090B0E" CornerRadius="6" ClipToBounds="True"><Image x:Name="MaskImage" Stretch="Fill"/></Border>
                                <TextBlock x:Name="ColorText" Text="Signal color  #D83434" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="RoiText" Text="ROI not selected" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="PIPELINE SIMULATOR" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <DockPanel Margin="0,12,0,5"><TextBlock Text="Synthetic HP"/><TextBlock x:Name="SimulatorValueText" Text="65%" DockPanel.Dock="Right" FontWeight="SemiBold"/></DockPanel>
                                <Slider x:Name="SimulatorSlider" Minimum="1" Maximum="100" Value="65" ValueChanged="SimulatorSlider_ValueChanged"/>
                                <Border Height="42" Background="#090B0E" CornerRadius="5" ClipToBounds="True" Margin="0,10,0,14"><Image x:Name="SyntheticImage" Stretch="Fill"/></Border>
                                <WrapPanel>
                                    <Button Content="Safe" Click="PreviewSafe_Click" Margin="0,0,8,0"/>
                                    <Button Content="Warning" Click="PreviewWarning_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Critical" Click="PreviewCritical_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
