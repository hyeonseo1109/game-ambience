<Window x:Class="GameAmbient.Windows.Overlay.AmbientOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Opacity="0">
    <Grid IsHitTestVisible="False">
        <Border x:Name="TopGlow" Height="150" VerticalAlignment="Top">
            <Border.Background><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop x:Name="TopColor" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <Border x:Name="BottomGlow" Height="150" VerticalAlignment="Bottom">
            <Border.Background><LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0"><GradientStop x:Name="BottomColor" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <Border x:Name="LeftGlow" Width="150" HorizontalAlignment="Left">
            <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop x:Name="LeftColor" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <Border x:Name="RightGlow" Width="150" HorizontalAlignment="Right">
            <Border.Background><LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5"><GradientStop x:Name="RightColor" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
    </Grid>
</Window>
